{
  "name": "poker-bankroll-tracker",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
  "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
  "dev:server": "npm run dev --workspace server",
  "dev:web": "npm run dev --workspace web",

  "build": "npm run build --workspace web",
  "start": "concurrently \"npm run start --workspace server\" \"npm run start --workspace web\"",

  "test": "npm run test:server && npm run test:web",
  "test:server": "npm --workspace server test",
  "test:web": "npm --workspace web test",
  "test:watch": "concurrently \"npm --workspace server test -- --watch\" \"npm --workspace web test -- --watch\"",

  "build:web": "npm run build --workspace web",
  "start:web": "npm run start --workspace web",
  "start:server": "npm run start --workspace server"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "recharts": "^3.7.0"
  }
}